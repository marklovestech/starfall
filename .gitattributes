# Treat DOS executables, overlays, and data files as binary so Git
# does not attempt to diff or convert line endings in them.

*.COM binary
*.DAT binary
*.PIC binary
*.LTR binary
*.doc binary
*.[0-9][0-9][0-9] binary

# Docs folder contains binary documents with no/unknown encoding.
orig1986/docs/CHARTS binary
orig1986/docs/MANUAL binary
orig1986/docs/SPECS.TXT binary
